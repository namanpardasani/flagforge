# Copy to .env and adjust. Never commit the real .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME"
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
# Separate database used only by tests (tables get wiped). Name must end in _test.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME_test"
# Optional. Without REDIS_URL the server works but has no cache, and rate limits/events are per-instance.
# REDIS_URL="redis://localhost:6379"
# Number of reverse proxies in front of the server (Render, nginx...), so rate limits see real client IPs.
# TRUST_PROXY=0
# Set to false for load tests from a single machine.
# RATE_LIMIT_ENABLED=true
# Redis database used only by tests (flushed between tests). Must end in /10 .. /15, never /0.
TEST_REDIS_URL="redis://localhost:6379/15"
