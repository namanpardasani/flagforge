// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String
  // Set when the person proves they own the address (by opening the emailed link, or by resetting
  // their password through it). Null = not proven.
  emailVerifiedAt  DateTime?
  createdAt        DateTime          @default(now())
  memberships      WorkspaceMember[]
  ownedWorkspaces  Workspace[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  apiKeysCreated   ApiKey[]
  emailTokens      EmailToken[]
  scheduledChanges ScheduledChange[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  ownerId          String
  plan             String            @default("free")
  createdAt        DateTime          @default(now())
  owner            User              @relation(fields: [ownerId], references: [id])
  members          WorkspaceMember[]
  projects         Project[]
  environments     Environment[]
  flags            Flag[]
  flagStates       FlagState[]
  auditLogs        AuditLog[]
  apiKeys          ApiKey[]
  experiments      Experiment[]
  scheduledChanges ScheduledChange[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        Role
  joinedAt    DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Project {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  key          String
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environments Environment[]
  flags        Flag[]
  experiments  Experiment[]

  @@unique([workspaceId, key])
}

model Environment {
  id               String            @id @default(cuid())
  workspaceId      String
  projectId        String
  name             String
  key              String
  // Bumped, in the same transaction, by every change that alters this environment's SDK config.
  configVersion    Int               @default(0)
  createdAt        DateTime          @default(now())
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  flagStates       FlagState[]
  apiKeys          ApiKey[]
  experiments      Experiment[]
  scheduledChanges ScheduledChange[]

  @@unique([projectId, key])
  @@index([workspaceId])
}

model Flag {
  id               String            @id @default(cuid())
  workspaceId      String
  projectId        String
  key              String
  name             String
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  states           FlagState[]
  experiments      Experiment[]
  scheduledChanges ScheduledChange[]

  @@unique([projectId, key])
  @@index([workspaceId])
}

// One row per (flag, environment). No row means the flag is off in that environment.
model FlagState {
  flagId         String
  environmentId  String
  workspaceId    String
  enabled        Boolean     @default(false)
  // Targeting, in the shape of @flagforge/core: rules array + fallthrough rollout in basis points (10000 = everyone).
  rules          Json        @default("[]")
  fallthroughBps Int         @default(10000)
  updatedAt      DateTime    @updatedAt
  flag           Flag        @relation(fields: [flagId], references: [id], onDelete: Cascade)
  environment    Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([flagId, environmentId])
  @@index([workspaceId])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

// Server-side SDK key for one environment. Only the SHA-256 hash is stored; the full key is shown once.
model ApiKey {
  id            String      @id @default(cuid())
  workspaceId   String
  environmentId String
  name          String
  keyHash       String      @unique
  prefix        String
  createdById   String?
  createdAt     DateTime    @default(now())
  revokedAt     DateTime?
  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdBy     User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([environmentId])
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  STOPPED
}

// An A/B test on one flag in one environment: users who get the flag are "treatment", the rest "control".
// At most one experiment per flag and environment may be RUNNING at a time (a partial unique index
// added by hand in the migration enforces it, because Prisma cannot express one).
model Experiment {
  id            String                 @id @default(cuid())
  workspaceId   String
  projectId     String
  environmentId String
  flagId        String
  name          String
  hypothesis    String?
  // The event your code reports when a user does the thing being measured, e.g. "checkout-completed".
  metricKey     String
  status        ExperimentStatus       @default(DRAFT)
  startedAt     DateTime?
  stoppedAt     DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment   Environment            @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  flag          Flag                   @relation(fields: [flagId], references: [id], onDelete: Cascade)
  exposures     ExperimentExposure[]
  conversions   ExperimentConversion[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([environmentId, status])
}

// One row per user per experiment: which variant they FIRST saw. The user key is stored only as a
// hash that is specific to the experiment, so rows cannot be linked across experiments or back to a person.
model ExperimentExposure {
  experimentId String
  userHash     String
  workspaceId  String
  // true = got the flag (treatment), false = did not (control)
  variant      Boolean
  firstSeenAt  DateTime   @default(now())
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@id([experimentId, userHash])
  @@index([workspaceId])
}

// One row per user who converted, counted at most once. Only users with an exposure are recorded.
model ExperimentConversion {
  experimentId String
  userHash     String
  workspaceId  String
  firstSeenAt  DateTime   @default(now())
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@id([experimentId, userHash])
  @@index([workspaceId])
}

enum EmailTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// A single-use secret sent by email. Only its SHA-256 hash is stored, so a database leak does not
// leak usable links. It can be used once (usedAt) and only before it expires.
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

enum ScheduledChangeStatus {
  PENDING
  RUNNING
  APPLIED
  CANCELLED
  FAILED
}

// "At this time, set this flag's state in this environment to this." The patch has the same shape
// as a normal flag-state update and is validated the same way when it is created AND when it runs.
model ScheduledChange {
  id            String                @id @default(cuid())
  workspaceId   String
  flagId        String
  environmentId String
  createdById   String?
  runAt         DateTime
  patch         Json
  status        ScheduledChangeStatus @default(PENDING)
  // Set when a runner claims it. A claim that is never finished (the process died) expires.
  claimedAt     DateTime?
  appliedAt     DateTime?
  // Why a change did not apply (kept short, never contains secrets).
  failure       String?
  createdAt     DateTime              @default(now())
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flag          Flag                  @relation(fields: [flagId], references: [id], onDelete: Cascade)
  environment   Environment           @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdBy     User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([flagId, environmentId, status])
  @@index([status, runAt])
}
